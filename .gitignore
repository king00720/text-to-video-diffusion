import argparse
import os

import torch

from model import (
    PROMPTS,
    VideoDiffusionModel,
    denoise_sample,
    save_gif,
    tokenize_prompt,
)


def sample(prompt: str, checkpoint: str = "checkpoints/final_model.pt", output_path: str = "outputs/demo.gif"):
    model = VideoDiffusionModel()
    if os.path.exists(checkpoint):
        state = torch.load(checkpoint, map_location="cpu")
        model.load_state_dict(state)
    else:
        raise FileNotFoundError(f"Checkpoint not found: {checkpoint}. Train the model first with python train.py")

    generated = denoise_sample(model, prompt, frames=8, size=16, steps=20)
    save_gif(generated, output_path)
    print(f"Saved generated video to {output_path}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Generate a toy video from a text prompt")
    parser.add_argument("--prompt", type=str, default="red circle moving right", help="Text prompt")
    parser.add_argument("--checkpoint", type=str, default="checkpoints/final_model.pt", help="Checkpoint path")
    parser.add_argument("--output", type=str, default="outputs/demo.gif", help="Output GIF path")
    args = parser.parse_args()
    sample(args.prompt, args.checkpoint, args.output)
